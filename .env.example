# DEV: copiar a .env.development.local y usar Supabase local.
# PROD: scripts/build-pages.mjs usa config/production.json (clave publicable).
# DEV: npm run dev:configure obtiene estos valores del Supabase local.
NEXT_PUBLIC_APP_ENV=dev
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_BASE_PATH=
# Nunca colocar service_role, secret keys o contraseñas de DB en NEXT_PUBLIC_*.
